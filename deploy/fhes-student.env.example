# FHES v6.2 學生系統：環境變數範本（複製成 /srv/fhes-student/fhes-student.env，權限 600，不要放進 Git）
# 說明：docs/STUDENT-DEPLOY-GUIDE.md 第 3 節

# 允許使用學生系統的老師：完整 email 或 @學校網域，用逗號分隔（Google 帳號的 email 必須已驗證）
FHES_TEACHER_ALLOW=teacher.name@school.example.edu.tw,@school.example.edu.tw

# 教師端網頁的來源（GitHub Pages）。只寫「通訊協定＋網域」，不要有路徑或結尾斜線
FHES_TEACHER_ORIGINS=https://yongliancai.github.io

# 學生頁面的網址來源（你的子網域）
FHES_STUDENT_ORIGINS=https://fhes.school.example.edu.tw

# 在 nginx 後面一定設 1（才會用 nginx 給的真實 IP 做限流）；直接對外才設 0
FHES_TRUST_PROXY=1

# 稽核紀錄 IP 雜湊用的亂數（至少 32 個字元）。產生方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FHES_IP_SALT=請換成上面指令產生的亂數

# 資料庫與監聽位置（只聽本機，由 nginx 轉進來）
FHES_DB_PATH=/srv/fhes-student/data/fhes-student.db
FHES_HOST=127.0.0.1
FHES_PORT=8790

# 備份（server/backup.mjs）
FHES_BACKUP_DIR=/srv/fhes-student/backups
FHES_BACKUP_KEY_FILE=/srv/fhes-student/secrets/backup.key
FHES_BACKUP_KEEP_DAYS=30
